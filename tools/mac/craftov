def install_self(data):
    """Replaces this extension with `data`, after the new version has shown it
    runs and can still update itself: a broken update must stay fixable from
    the server."""
    me = os.path.realpath(sys.argv[0])
    ext_dir = os.path.realpath(os.path.join(HOME, ".local", "libexec", "remote-gate"))
    if os.path.dirname(me) != ext_dir:
        raise Fail("not running as an installed gate extension (%s)" % me)
    with open(me, "rb") as f:
        if f.read() == data:
            return "the craftov extension is already current"
    if not data.startswith(b"#!/usr/bin/python3"):
        raise Fail("not a craftov extension (no python shebang)")
    # A dot name: the gate never runs it as an extension while it is checked.
    tmp = os.path.join(ext_dir, ".craftov.new")
    with open(tmp, "wb") as f:
        f.write(data)
    os.chmod(tmp, 0o755)
    try:
        r = subprocess.run([tmp, "selfupdate", "--check"], capture_output=True, text=True, env=env(),
                           stdin=subprocess.DEVNULL, timeout=30)
        if r.returncode != 0 or r.stdout.strip() != "selfupdate ok":
            raise Fail("the new version did not pass its check, keeping this one:\n"
                       + (r.stderr or r.stdout).strip()[-1500:])
        os.replace(tmp, me)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)
    return "updated the craftov extension (sha256 %s)" % hashlib.sha256(data).hexdigest()[:12]


def cmd_selfupdate(args):
    if args == ["--check"]:
        print("selfupdate ok")
        return
    if args:
        raise Fail("usage: craftov selfupdate < tools/mac/craftov")
    print(install_self(sys.stdin.buffer.read()))


def self_update_from_checkout():
    """After a sync: follow the checkout's copy, so changes to the extension
    arrive with the commits that make them."""
    path = os.path.join(PROJECT, "tools", "mac", "craftov")
    if not os.path.exists(path):
        return
    with open(path, "rb") as f:
        data = f.read()
    try:
        msg = install_self(data)
    except Fail as exc:
        print("warning: extension not updated: %s" % exc)
        return
    if not msg.endswith("already current"):
        print(msg)


def cmd_sync(args):
    sync_checkout(args)
    self_update_from_checkout()


def sync_checkout(args):
    park = None
    if args:
        if len(args) != 2 or args[0] != "--park":
            raise Fail("usage: craftov sync [--park <name>]")
        park = args[1]
    check_project()
    if park is not None:
        # Plain names only: git expands forms like @{-1}, and APFS folds case.
        fmt = git("check-ref-format", "--branch", park, check=False)
        if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,63}", park) or fmt.returncode != 0
                or fmt.stdout.strip() != park or park.lower() == "main"):
            raise Fail("--park needs a plain branch name other than main")
    data = sys.stdin.buffer.read()
    if not re.match(rb"# v[23] git bundle", data):
        raise Fail("sync reads a git bundle on stdin: git bundle create - main | ssh mac craftov sync")
    git_dir = git("rev-parse", "--absolute-git-dir").stdout.strip()
    bundle = os.path.join(git_dir, "craftov-sync.bundle")
    with open(bundle, "wb") as f:
        f.write(data)
    try:
        verify = git("bundle", "verify", bundle, check=False)
        if verify.returncode != 0:
            raise Fail("the bundle does not apply here (send a full one):\n" + verify.stderr.strip())
        git("fetch", "--quiet", "--no-tags", bundle, "+refs/heads/main:refs/craftov/synced")
    finally:
        os.remove(bundle)
    target = git("rev-parse", "refs/craftov/synced").stdout.strip()
    head = git("rev-parse", "HEAD").stdout.strip()
    branch = git("symbolic-ref", "--short", "-q", "HEAD", check=False).stdout.strip()
    if head == target and branch == "main":
        print("already at " + git("log", "-1", "--format=%h %s").stdout.strip())
        return
    parking = not is_ancestor(head, target)
    if parking and park is None:
        raise Fail("the Mac checkout (%s %s) has commits the server does not: push them, or rerun "
                   "with --park <name> to keep them on a branch of that name" % (branch or "detached", head[:8]))
    if parking and not branch:
        raise Fail("the Mac checkout is a detached HEAD with commits the server does not; "
                   "put them on a branch first")
    if parking and park.lower() in (b.lower() for b in git(
            "for-each-ref", "--format=%(refname:short)", "refs/heads/").stdout.split()):
        raise Fail("a branch named %s already exists on the Mac" % park)
    changed = git("status", "--porcelain", "--untracked-files=no").stdout.rstrip()
    if changed:
        raise Fail("the Mac checkout has uncommitted changes; commit or discard them first:\n" + changed)
    local = git("rev-parse", "--verify", "-q", "refs/heads/main", check=False).stdout.strip()
    if branch != "main" and local and not is_ancestor(local, target):
        raise Fail("the local branch main has commits the server does not; move them first")
    here = os.path.realpath(git("rev-parse", "--show-toplevel").stdout.strip())
    for block in git("worktree", "list", "--porcelain").stdout.split("\n\n"):
        fields = dict(l.split(" ", 1) for l in block.splitlines() if " " in l)
        if fields.get("branch") == "refs/heads/main" and os.path.realpath(fields.get("worktree", "")) != here:
            # Git before 2.44 would move main under that worktree without a word.
            raise Fail("main is checked out in another worktree at %s" % fields["worktree"])
    if branch == "main" and not parking:
        git("merge", "--quiet", "--ff-only", "refs/craftov/synced")
    else:
        if parking:
            # Rename, never delete: the commits stay on <park>.
            git("branch", "-m", branch, park)
        try:
            # Not `checkout -B`: before Git 2.44 it ignores other worktrees.
            if git("rev-parse", "--verify", "-q", "refs/heads/main", check=False).returncode == 0:
                git("branch", "--quiet", "-f", "main", "refs/craftov/synced")  # a fast-forward, checked above
                git("checkout", "--quiet", "main")
            else:
                git("checkout", "--quiet", "-b", "main", "refs/craftov/synced")
        except Fail:
            if parking:
                git("branch", "-m", park, branch)  # back as it was
            raise
        if parking:
            # It no longer follows the remote branch it was cut from.
            git("branch", "--unset-upstream", park, check=False)
            print("kept %s %s as branch %s" % (branch, head[:8], park))
        git("branch", "--quiet", "--set-upstream-to=origin/main", "main", check=False)
    print("main now at %s (was %s on %s)" % (git("log", "-1", "--format=%h %s").stdout.strip(),
                                             head[:8], branch or "detached HEAD"))


def cmd_jar():
    check_run()
    data = sys.stdin.buffer.read()
    try:
        names = zipfile.ZipFile(io.BytesIO(data)).namelist()
    except zipfile.BadZipFile:
        raise Fail("jar reads a plugin jar on stdin")
    if "plugin.yml" not in names and "paper-plugin.yml" not in names:
        raise Fail("not a plugin jar (no plugin.yml)")
    target = os.path.join(RUN, "plugins", "Craftov.jar")
    tmp = target + ".part"
    with open(tmp, "wb") as f:
        f.write(data)
    # A rename leaves a running server's open jar intact; copying over it would not.
    os.replace(tmp, target)
    print("installed Craftov.jar (%d KB, sha256 %s); restart to load it" % (
        len(data) // 1024, hashlib.sha256(data).hexdigest()[:12]))


def cmd_build():
    check_project()
    if not java_home():
        raise Fail("JDK 25 not found")
    r = subprocess.run(["./gradlew", "deployLocal", "--console=plain", "--quiet"], cwd=PROJECT,
                       env=env(), stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        raise Fail("gradle failed (exit %d)" % r.returncode)
    print("built and copied to server/run/plugins/Craftov.jar; restart to load it")


def cmd_setup():
    check_project()
    if os.path.exists(os.path.join(RUN, "paper.jar")):
        raise Fail("server/run already exists; setup only creates a new one")
    r = subprocess.run(["/bin/bash", "server/setup.sh", "--local"], cwd=PROJECT, env=env(),
                       stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        raise Fail("setup failed (exit %d)" % r.returncode)
    ensure_rcon()


def cmd_start(timeout=300):
    check_run()
    if server_pids():
        print("already running")
        return
    old = log_inode()
    if loop_pids():
        print("the restart loop is bringing the server up")
        wait_done(old, timeout)
        return
    ensure_rcon()
    jh = java_home()
    if not jh:
        raise Fail("JDK 25 not found")
    script = next((s for s in ("run-forever.sh", "start.sh") if os.path.exists(os.path.join(RUN, s))), None)
    argv = (["/bin/bash", script] if script else
            [os.path.join(jh, "bin", "java"), "-Xms2G", "-Xmx4G", "-XX:+UseG1GC", "-jar", "paper.jar", "--nogui"])
    out = open(os.path.join(RUN, "console.log"), "ab")
    # Own session, no inherited fds: it outlives this ssh call and the call can return.
    proc = subprocess.Popen(argv, cwd=RUN, env=env(), stdin=subprocess.DEVNULL, stdout=out,
                            stderr=subprocess.STDOUT, start_new_session=True)
    print("started %s" % (script or "paper.jar"))
    try:
        wait_done(old, timeout)
    except Fail:
        # Don't leave a loop we started relaunching a broken server.
        term(proc.pid)
        for pid in server_pids():
            term(pid)
        raise


def term(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass  # already gone, which is what we wanted


def parent(pid):
    r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, env=env())
    word = r.stdout.strip()
    return int(word) if word.isdigit() else None


def quit_screens(pids):
    """Closes a screen session (`screen -dmS craftov ./run-forever.sh`) only if it
    is the parent of a process this checkout ran. -S gets the full pid.name:
    a bare name matches every session that starts with it."""
    screen = shutil.which("screen", path=BASE_PATH)
    if not screen or not pids:
        return
    listing = run([screen, "-ls"], check=False).stdout
    for pid in pids:
        if re.search(r"^\s*%d\.craftov\s" % pid, listing, re.M):
            run([screen, "-S", "%d.craftov" % pid, "-X", "quit"], check=False)


def cmd_stop(timeout=120):
    check_run()
    loops, srv = loop_pids(), server_pids()
    parents = [p for p in (parent(pid) for pid in loops + srv) if p]
    # The loop first, or it brings the server straight back up.
    for pid in loops:
        term(pid)
    srv = server_pids()
    if srv:
        try:
            rcon("stop")
        except (Fail, OSError):
            for pid in srv:
                term(pid)  # Paper saves and stops on SIGTERM too
        deadline = time.time() + timeout
        while any(alive(pid) for pid in srv):
            if time.time() > deadline:
                raise Fail("still running after %d s: pid %s" % (timeout, ",".join(map(str, srv))))
            time.sleep(1)
    quit_screens(parents)
    print("stopped")


def cmd_restart(timeout=300):
    check_run()
    srv = server_pids()
    if srv and loop_pids():
        ensure_rcon()
        old = log_inode()
        try:
            rcon("stop")
        except (Fail, OSError):
            for pid in srv:
                term(pid)
        print("stopping; the restart loop brings it back up")
        wait_done(old, timeout, old_pids=srv)
        return
    cmd_stop()
    cmd_start(timeout)


def cmd_rcon(args):
    if not args:
        raise Fail("usage: craftov rcon <command...>")
    # Take the command verbatim from the ssh line, so quotes in JSON survive.
    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    m = re.match(r"\s*craftov\s+rcon\s+(.+?)\s*$", raw, re.S)
    print(rcon(m.group(1) if m else " ".join(args)).rstrip())


def pack_ip():
    try:
        with open(os.path.join(RUN, "plugins", "CraftEngine", "config.yml"), encoding="utf-8") as f:
            m = re.search(r'\n  self-host:\n    ip: "([^"]*)"', f.read())
    except FileNotFoundError:
        return None
    return m.group(1) if m else None


def cmd_packip(ip):
    check_run()
    if not re.fullmatch(r"(\d{1,3})(\.\d{1,3}){3}", ip) or any(int(x) > 255 for x in ip.split(".")):
        raise Fail("packip takes an IPv4 address")
    path = os.path.join(RUN, "plugins", "CraftEngine", "config.yml")
    with open(path, encoding="utf-8") as f:
        text = f.read()
    text, n = re.subn(r'(\n  self-host:\n    ip: )"[^"]*"', r'\g<1>"%s"' % ip, text)
    if n != 1:
        raise Fail("self-host ip not found in " + path)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    print("pack ip set to " + ip)
    if server_pids():
        print(rcon("ce reload all").strip() or "ce reload all sent")


def cmd_yml(action, name):
    check_run()
    allowed = YML_COPY if action == "copy" else YML_DIFF
    if action not in ("diff", "copy") or name not in allowed:
        raise Fail("usage: craftov yml diff %s | craftov yml copy %s" % ("|".join(YML_DIFF), "|".join(YML_COPY)))
    repo = os.path.join(PROJECT, "src", "main", "resources", name)
    live = os.path.join(RUN, "plugins", "Craftov", name)
    if not os.path.exists(repo):
        raise Fail("the checkout has no src/main/resources/%s: is it on main? (craftov sync)" % name)
    with open(repo, encoding="utf-8") as f:
        new = f.read().splitlines(keepends=True)
    old = []
    if os.path.exists(live):
        with open(live, encoding="utf-8") as f:
            old = f.read().splitlines(keepends=True)
    if action == "diff":
        diff = "".join(difflib.unified_diff(old, new, "server/run/plugins/Craftov/" + name,
                                            "src/main/resources/" + name))
        print(diff.rstrip() or "identical")
        return
    if os.path.exists(live):
        backup = live + time.strftime(".%Y%m%d-%H%M%S.bak")
        shutil.copy2(live, backup)
        print("backed up the server copy to " + os.path.relpath(backup, RUN))
    shutil.copyfile(repo, live)
    print("copied %s into plugins/Craftov; restart to load it" % name)


def cmd_log(args, path):
    n = line_count(args[0] if args else None)
    if not os.path.exists(path):
        raise Fail("no log at " + path)
    print(tail(path, n))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "-h", "--help"):
        sys.stdout.write(__doc__)
        return
    cmd, rest = args[0], args[1:]
    simple = {"status": cmd_status, "head": cmd_head, "branches": cmd_branches,
              "bundle": cmd_bundle, "jar": cmd_jar,
              "build": cmd_build, "setup": cmd_setup, "start": cmd_start, "stop": cmd_stop,
              "restart": cmd_restart}
    try:
        if cmd in simple and not rest:
            simple[cmd]()
        elif cmd == "sync":
            cmd_sync(rest)
        elif cmd == "selfupdate":
            cmd_selfupdate(rest)
        elif cmd == "rcon":
            cmd_rcon(rest)
        elif cmd == "log" and len(rest) <= 1:
            cmd_log(rest, LATEST_LOG)
        elif cmd == "consolelog" and len(rest) <= 1:
            cmd_log(rest, os.path.join(RUN, "console.log"))
        elif cmd == "clientlog" and len(rest) <= 1:
            cmd_log(rest, CLIENT_LOG)
        elif cmd == "packip" and len(rest) == 1:
            cmd_packip(rest[0])
        elif cmd == "yml" and len(rest) == 2:
            cmd_yml(rest[0], rest[1])
        else:
            raise Fail("unknown command; see `craftov help`")
    except PermissionError as exc:
        sys.stderr.write("craftov: %s\n%s\n" % (exc, TCC_HINT))
        sys.exit(1)
    except (Fail, OSError) as exc:
        sys.stderr.write("craftov: %s\n" % exc)
        sys.exit(1)


main()
