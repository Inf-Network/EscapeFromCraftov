HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(HOME, ".config", "craftov-gate")


def conf(name, default):
    """A path the Mac's user may override in ~/.config/craftov-gate/<name>."""
    try:
        with open(os.path.join(CONF_DIR, name)) as f:
            value = f.read().strip()
    except FileNotFoundError:
        return default
    return os.path.expanduser(value) if value else default


PROJECT = conf("project", os.path.join(HOME, "Documents", "projects", "plugins", "EscapeFromCraftov"))
RUN = os.path.join(PROJECT, "server", "run")
LATEST_LOG = os.path.join(RUN, "logs", "latest.log")
CLIENT_LOG = conf("clientlog", os.path.join(
    HOME, "Documents", "minecraft", ".minecraft", "versions", "1.21.11-NeoForge", "logs", "latest.log"))
JDKS = ("/Library/Java/JavaVirtualMachines/zulu-25.jdk/Contents/Home",
        "/usr/lib/jvm/java-25-openjdk-amd64", "/usr/lib/jvm/java-25-openjdk")
# sshd gives forced commands a bare PATH; Homebrew tools live outside it.
BASE_PATH = "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"
YML_COPY = ("items.yml", "loot.yml")
YML_DIFF = YML_COPY + ("config.yml",)
TCC_HINT = (
    "macOS keeps ssh sessions out of ~/Documents (privacy protection). Either turn on\n"
    "  System Settings > General > Sharing > Remote Login (i) > Allow full disk access for remote users\n"
    "or move the project out of ~/Documents and write its new path into ~/.config/craftov-gate/project.")


class Fail(Exception):
    pass


# ---------------------------------------------------------------- helpers

_java_home = []


def java_home():
    if not _java_home:
        found = next((p for p in JDKS if os.path.exists(os.path.join(p, "bin", "java"))), None)
        if found is None and os.path.exists("/usr/libexec/java_home"):
            r = subprocess.run(["/usr/libexec/java_home", "-v", "25"], capture_output=True, text=True)
            if r.returncode == 0 and r.stdout.strip():
                found = r.stdout.strip()
        _java_home.append(found)
    return _java_home[0]


def env():
    e = {"HOME": HOME, "PATH": BASE_PATH, "LANG": "en_US.UTF-8", "GIT_TERMINAL_PROMPT": "0"}
    for key in ("USER", "LOGNAME", "TMPDIR"):
        if key in os.environ:
            e[key] = os.environ[key]
    jh = java_home()
    if jh:
        e["JAVA_HOME"] = jh
        e["JAVA"] = os.path.join(jh, "bin", "java")
        e["PATH"] = os.path.join(jh, "bin") + ":" + BASE_PATH
    return e


def run(argv, cwd=None, check=True):
    r = subprocess.run(argv, cwd=cwd or PROJECT, env=env(), stdin=subprocess.DEVNULL,
                       capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Fail("%s failed (exit %d):\n%s" % (" ".join(argv[:3]), r.returncode,
                                                 (r.stderr or r.stdout).strip()))
    return r


def git(*args, check=True):
    return run(["git"] + list(args), check=check)


def is_ancestor(a, b):
    return git("merge-base", "--is-ancestor", a, b, check=False).returncode == 0


def check_project():
    try:
        os.stat(os.path.join(PROJECT, ".git"))
    except FileNotFoundError:
        raise Fail("no git checkout at %s (put its path in ~/.config/craftov-gate/project)" % PROJECT)


def check_run():
    check_project()
    if not os.path.exists(os.path.join(RUN, "paper.jar")):
        raise Fail("no server in %s yet: run `craftov setup` first" % RUN)


def props():
    out = {}
    try:
        with open(os.path.join(RUN, "server.properties"), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    out[key.strip()] = value.strip()
    except FileNotFoundError:
        pass
    return out


def set_props(updates):
    path = os.path.join(RUN, "server.properties")
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    left = dict(updates)
    for i, line in enumerate(lines):
        key = line.split("=", 1)[0].strip()
        if "=" in line and not line.lstrip().startswith("#") and key in left:
            lines[i] = "%s=%s" % (key, left.pop(key))
    lines += ["%s=%s" % kv for kv in left.items()]
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def tail(path, n):
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - max(65536, n * 400)))
        data = f.read()
    return "\n".join(data.decode("utf-8", "replace").splitlines()[-n:])


def line_count(arg, default=60):
    if arg is None:
        return default
    if not re.fullmatch(r"[0-9]{1,4}", arg) or not 0 < int(arg) <= 5000:
        raise Fail("lines must be a number from 1 to 5000")
    return int(arg)


# ------------------------------------------------------------- processes

def same_dir(a, b):
    try:
        return os.path.realpath(a) == os.path.realpath(b)
    except OSError:
        return False


def proc_cwd(pid):
    r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"], capture_output=True,
                       text=True, env=env())
    return next((l[1:] for l in r.stdout.splitlines() if l.startswith("n")), None)


def proc_cmd(pid):
    r = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True, env=env())
    return r.stdout.strip()


def procs(pattern):
    """Pids whose command line matches `pattern` and that run inside server/run."""
    r = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True, env=env())
    out = []
    for word in r.stdout.split():
        pid = int(word)
        if pid != os.getpid() and same_dir(proc_cwd(pid) or "/nonexistent", RUN):
            out.append(pid)
    return out


def server_pids():
    return procs("paper.jar")


def loop_pids():
    """The run-forever.sh restart loop: only the shell, not a screen wrapping it."""
    out = []
    for pid in procs("run-forever.sh"):
        first = proc_cmd(pid).split(" ", 1)[0]
        if os.path.basename(first) in ("bash", "sh", "zsh", "dash", "run-forever.sh"):
            out.append(pid)
    return out


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def listening(port):
    r = subprocess.run(["lsof", "-nP", "-iTCP:%s" % port, "-sTCP:LISTEN", "-t"], capture_output=True,
                       text=True, env=env())
    return [int(p) for p in r.stdout.split()]


def log_inode():
    try:
        return os.stat(LATEST_LOG).st_ino
    except FileNotFoundError:
        return None


def wait_done(old_inode, timeout, old_pids=()):
    """Waits for a fresh latest.log (Paper rotates it on start) to report "Done (".

    The inode check matters on a restart: the old server's log also contains a
    "Done (" line and keeps being written while it shuts down. Under the restart
    loop a broken server never leaves the loop idle, so two server processes
    dying without "Done", or no server process at all for a while (a java that
    dies at once is never seen), count as a failed start. old_pids are the ones
    being stopped: they are meant to die, and while they save the world the
    loop is not expected to start anything."""
    deadline = time.time() + timeout
    seen, died = set(), set()
    last_busy = time.time()
    while time.time() < deadline:
        time.sleep(2)
        inode = log_inode()
        if inode is not None and inode != old_inode:
            with open(LATEST_LOG, encoding="utf-8", errors="replace") as f:
                text = f.read()
            done = re.search(r"^.*Done \(.*$", text, re.M)
            if done:
                print(done.group(0).strip())
                port = props().get("server-port", "25565")
                print("listening on port %s" % port if listening(port) else "warning: nothing on port " + port)
                return
        now = set(server_pids()) - set(old_pids)
        died |= seen - now
        seen |= now
        if now or any(alive(pid) for pid in old_pids):
            last_busy = time.time()
        if not now and not loop_pids():
            raise Fail("the server exited while starting\n" + start_logs(old_inode))
        if len(died) >= 2 or time.time() - last_busy > 12:
            raise Fail("the server keeps exiting while starting (the restart loop is relaunching it)\n"
                       + start_logs(old_inode))
    raise Fail("no \"Done\" after %d s\n%s" % (timeout, start_logs(old_inode)))


def start_logs(old_inode):
    """console.log has what happens before Paper opens a fresh latest.log (a bad
    java, a corrupt jar); latest.log only counts once it was rotated."""
    out = []
    if log_inode() not in (None, old_inode):
        out.append("--- logs/latest.log\n" + tail(LATEST_LOG, 30))
    console = os.path.join(RUN, "console.log")
    if os.path.exists(console):
        out.append("--- console.log\n" + tail(console, 15))
    return "\n".join(out) or "(no log)"


# ------------------------------------------------------------------ RCON

def _read(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("RCON connection closed")
        buf += chunk
    return buf


def _packet(sock):
    (size,) = struct.unpack("<i", _read(sock, 4))
    data = _read(sock, size)
    rid, kind = struct.unpack("<ii", data[:8])
    return rid, kind, data[8:-2].decode("utf-8", "replace")


def _send(sock, rid, kind, body):
    data = body.encode("utf-8")
    sock.sendall(struct.pack("<iii", len(data) + 10, rid, kind) + data + b"\0\0")


def rcon(command):
    p = props()
    if p.get("enable-rcon") != "true":
        raise Fail("RCON is off in server.properties (craftov start turns it on)")
    port = int(p.get("rcon.port", "25575"))
    try:
        sock = socket.create_connection(("127.0.0.1", port), timeout=10)
    except OSError as exc:
        raise Fail("cannot reach RCON on port %d (%s): is the server running?" % (port, exc))
    try:
        with sock:
            _send(sock, 1, 3, p.get("rcon.password", ""))
            if _packet(sock)[0] == -1:
                raise Fail("RCON password rejected")
            _send(sock, 2, 2, command)
            try:
                parts = [_packet(sock)[2]]
            except OSError:
                if command.split()[0] == "stop":
                    return ""  # the server may hang up before it answers
                raise
            # Long replies come split into 4096-byte packets with no end marker.
            sock.settimeout(0.3)
            while True:
                try:
                    parts.append(_packet(sock)[2])
                except OSError:
                    break
    except OSError as exc:
        raise Fail("RCON on port %d: %s" % (port, exc))
    return re.sub("§.", "", "".join(parts))


def ensure_rcon():
    """Stopping the server cleanly needs RCON: turn it on with a private password."""
    p = props()
    if p.get("enable-rcon") == "true" and p.get("rcon.password"):
        return
    set_props({"enable-rcon": "true", "rcon.port": p.get("rcon.port", "25575"),
               "rcon.password": p.get("rcon.password") or secrets.token_hex(12),
               "broadcast-rcon-to-ops": "false"})
    print("turned on RCON in server.properties")


